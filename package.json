{
  "name": "socialmog-hq",
  "version": "0.1.0",
  "private": true,
  "description": "Socialmog HQ — internal agency operating system for Socialmog (influencer marketing & content agency).",
  "type": "module",
  "engines": {
    "node": "^22.18.0"
  },
  "scripts": {
    "dev": "node --watch-path=src/server --watch-path=src/shared --no-warnings=ExperimentalWarning src/server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node --no-warnings=ExperimentalWarning src/server/index.ts",
    "test": "node --no-warnings=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "papaparse": "^5.7.0",
    "pdfmake": "^0.2.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
