# Copy to .env and fill in. Never commit real secrets.
PORT=4000
# Where the SQLite database, uploads, generated reports and backups are stored.
DATA_DIR=./data
# Public base URL of this app (used for OAuth redirect URIs and invite links).
APP_BASE_URL=http://localhost:4000
# 32+ random characters. Used to encrypt stored integration tokens. Changing it invalidates stored tokens.
APP_SECRET=change-me-to-a-long-random-string
# Initial founder account created on first start if no users exist.
FOUNDER_EMAIL=founder@socialmog.in
FOUNDER_PASSWORD=
FOUNDER_NAME=Founder
# Load illustrative demo data on first start (clearly labelled as demo in the UI). 1 = yes.
SEED_DEMO=1

# --- Optional integrations (left unconnected when blank) ---
# Meta "Instagram API with Instagram Login" app credentials.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# OpenAI API for weekly analysis narratives. Financial totals are never computed by AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Session cookies are marked Secure in production (HTTPS required). Set to 0 only for a trusted HTTP-only LAN.
COOKIE_SECURE=1
